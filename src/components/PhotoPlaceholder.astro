---
// A placeholder "photograph" drawn as SVG — three abstract street-scene
// compositions (kind 0/1/2), each optionally mirrored, with a grain filter
// and a vignette so they read as photos rather than flat graphics.
// No real photographs exist yet (see docs/design-brief.md "Still open");
// swap this component for real <img>s once they do.
interface Props {
  kind: 0 | 1 | 2;
  flip?: boolean;
  index?: number;
}
const { kind, flip = false, index = 0 } = Astro.props;
const uid = `ph-${kind}-${flip ? 1 : 0}-${index}`;

// A unit standing-figure silhouette (h = 1); scaled/positioned per scene.
const FIGURE =
  'M-0.1,-1 a0.1,0.1 0 1,0 0.2,0 a0.1,0.1 0 1,0 -0.2,0 Z ' +
  'M-0.13,-0.78 L0.13,-0.78 L0.1,-0.38 L0.09,0 L0.01,0 L0,-0.36 L-0.01,0 L-0.09,0 L-0.1,-0.38 Z';
---

<svg
  class="photo-placeholder"
  viewBox="0 0 512 340"
  role="img"
  aria-label={`Placeholder photograph ${index + 1}`}
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id={`${uid}-sky`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#8c8c8c" />
      <stop offset="0.6" stop-color="#dcdcdc" />
    </linearGradient>
    <linearGradient id={`${uid}-ground`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#8c8c8c" />
      <stop offset="1" stop-color="#3a3a3a" />
    </linearGradient>
    <linearGradient id={`${uid}-wallL`} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#222222" />
      <stop offset="1" stop-color="#3b3b3b" />
    </linearGradient>
    <linearGradient id={`${uid}-arch`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f2f2f2" />
      <stop offset="1" stop-color="#9b9b9b" />
    </linearGradient>
    <radialGradient id={`${uid}-vignette`} cx="0.5" cy="0.5" r="0.75">
      <stop offset="0.45" stop-color="#000" stop-opacity="0" />
      <stop offset="1" stop-color="#000" stop-opacity="0.42" />
    </radialGradient>
    <filter id={`${uid}-grain`}>
      <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" stitchTiles="stitch" result="noise" />
      <feColorMatrix in="noise" type="saturate" values="0" />
      <feComponentTransfer>
        <feFuncA type="linear" slope="0.12" />
      </feComponentTransfer>
      <feComposite operator="in" in2="SourceGraphic" />
    </filter>
    <clipPath id={`${uid}-frame`}>
      <rect x="20" y="20" width="472" height="300" />
    </clipPath>
  </defs>

  <rect width="512" height="340" fill="#ecebe6" />

  <g clip-path={`url(#${uid}-frame)`} transform={flip ? 'translate(512,0) scale(-1,1)' : undefined}>
    {kind === 0 && (
      <g>
        <rect x="-50" y="-50" width="612" height="396" fill={`url(#${uid}-sky)`} />
        <rect x="-50" y="196" width="612" height="144" fill={`url(#${uid}-ground)`} />
        <rect x="-50" y="192" width="612" height="9" fill="#161616" />
        <rect x="131" y="62" width="18" height="146" fill="#161616" />
        <rect x="363" y="62" width="18" height="146" fill="#161616" />
        <rect x="126" y="54" width="28" height="12" fill="#161616" />
        <rect x="358" y="54" width="28" height="12" fill="#161616" />
        <path d="M-50,296 H562 V376 H-50 Z" fill="#0e0e0e" />
        <path d={FIGURE} fill="#0a0a0a" transform="translate(318,294) scale(62)" />
      </g>
    )}
    {kind === 1 && (
      <g>
        <rect width="512" height="340" fill={`url(#${uid}-sky)`} />
        <path d="M0,0 L205,128 L205,236 L0,340 Z" fill={`url(#${uid}-wallL)`} />
        <path d="M512,0 L318,132 L318,234 L512,340 Z" fill={`url(#${uid}-wallL)`} />
        <path d="M205,236 L318,234 L512,340 L0,340 Z" fill={`url(#${uid}-ground)`} />
        <path d="M250,292 L262,292 L392,330 L352,334 Z" fill="rgba(10,10,10,.55)" />
        <path d={FIGURE} fill="#0a0a0a" transform="translate(256,294) scale(58)" />
      </g>
    )}
    {kind === 2 && (
      <g>
        <rect width="512" height="340" fill="#141414" />
        {[0, 1, 2, 3].map((i) => (
          <path
            d={`M${58 + i * 112},250 V110 a37,37 0 0 1 74,0 V250 Z`}
            fill={`url(#${uid}-arch)`}
          />
        ))}
        <path d={FIGURE} fill="#0a0a0a" transform="translate(320,252) scale(70)" />
      </g>
    )}
    <rect x="20" y="20" width="472" height="300" fill={`url(#${uid}-vignette)`} />
    <rect x="20" y="20" width="472" height="300" filter={`url(#${uid}-grain)`} />
  </g>
</svg>

<style>
  .photo-placeholder {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.12), 0 8px 24px rgba(0, 0, 0, 0.1);
  }
</style>
