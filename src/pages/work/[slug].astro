---
import { getCollection } from 'astro:content';
import ItemPage from '../../layouts/ItemPage.astro';
import { SEC } from '../../data/sections.ts';

export async function getStaticPaths() {
  const items = await getCollection('work', ({ data }) => !data.draft);
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const s = SEC.work;
---

<ItemPage
  sectionLabel={s.label}
  sectionHref="/work"
  thing={s.thing}
  title={item.data.title}
  meta={`${item.data.role} · ${item.data.org} · ${item.data.date}`}
  summary={item.data.summary}
  stats={item.data.stats}
  tags={item.data.tags}
  draft
/>
