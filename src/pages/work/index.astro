---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SEC, prevNext } from '../../data/sections.ts';

const s = SEC.work;
const { prev, next } = prevNext('work');
const items = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={s.title} eyebrow={s.thing} lead={s.lead} prev={prev} next={next} draft>
  <div class="stack">
    {items.map((item) => (
      <article class="card">
        <h2><a href={`/work/${item.id}`}>{item.data.title}</a></h2>
        <p class="meta">{item.data.role} · {item.data.org} · {item.data.date}</p>
        <p>{item.data.summary}</p>
        {item.data.stats.length > 0 && (
          <ul class="chips stat">
            {item.data.stats.map((st) => <li>{st}</li>)}
          </ul>
        )}
        {item.data.tags.length > 0 && (
          <ul class="chips">
            {item.data.tags.map((t) => <li>{t}</li>)}
          </ul>
        )}
      </article>
    ))}
  </div>
</BaseLayout>

<style>
  .card h2 a {
    color: inherit;
    text-decoration: none;
  }
  .card h2 a:hover {
    color: var(--amber-deep);
  }
</style>
