---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SEC, prevNext } from '../../data/sections.ts';

const s = SEC.writing;
const { prev, next } = prevNext('writing');
const items = (await getCollection('writing', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={s.title} eyebrow={s.thing} lead={s.lead} prev={prev} next={next} draft>
  {items.length === 0 ? (
    <div class="empty">Nothing published yet. On the real site this section stays hidden until the first note exists.</div>
  ) : (
    <ul class="rows">
      {items.map((item) => (
        <li>
          <span class="when">{item.data.date}</span>
          <span>
            <b><a href={`/writing/${item.id}`}>{item.data.title}</a></b>
            <small>{item.data.summary}</small>
          </span>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>

<style>
  .rows b a {
    color: inherit;
    text-decoration: none;
  }
  .rows b a:hover {
    color: var(--amber-deep);
  }
</style>
