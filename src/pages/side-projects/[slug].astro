---
import { getCollection } from 'astro:content';
import ItemPage from '../../layouts/ItemPage.astro';
import { SEC } from '../../data/sections.ts';

export async function getStaticPaths() {
  const items = await getCollection('side-projects', ({ data }) => !data.draft);
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const s = SEC['side-projects'];
---

<ItemPage
  sectionLabel={s.label}
  sectionHref="/side-projects"
  thing={s.thing}
  title={item.data.title}
  meta={item.data.date}
  summary={item.data.summary}
  tags={item.data.tags}
  draft
/>
