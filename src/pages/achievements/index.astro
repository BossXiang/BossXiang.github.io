---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SEC, prevNext } from '../../data/sections.ts';

const s = SEC.achievements;
const { prev, next } = prevNext('achievements');
const items = (await getCollection('achievements', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={s.title} eyebrow={s.thing} lead={s.lead} prev={prev} next={next} draft>
  <ul class="rows">
    {items.map((item) => (
      <li>
        <span class="when">{item.data.date}</span>
        <span>
          <b><a href={`/achievements/${item.id}`}>{item.data.title}</a></b>
          {item.data.detail && <small>{item.data.detail}</small>}
        </span>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .rows b a {
    color: inherit;
    text-decoration: none;
  }
  .rows b a:hover {
    color: var(--amber-deep);
  }
</style>
